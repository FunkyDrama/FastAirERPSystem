@startuml FastAir
title FastAir ERP-System

skinparam packageStyle rectangle
allowmixing

actor Customer
actor StaffUser

package "frontend-customer (React)" as FE_USER {
  class Home
  class FlightOptions
  class Checkout
  class Confirmation
  class Dashboard
  class CheckIn
}


package "frontend-staff (React)" as FE_STAFF {
  class StaffLogin
  class FlightsOfDay
  class CheckinPanel
  class GateBoarding
  class AdminPanel
}


node "Nginx (reverse proxy + static)\nHTTPS :443" as NGINX

package "users-service (FastAPI)\nDB: users_db (PostgreSQL)" {

  package "users.db.models" as users_models {
      class UserAccount {
          +user_id: UUID
          +email: str
          +password_hash: str
          +role: Role
          +balance: Decimal
      }

      class Passenger {
          +passenger_id: UUID
          +name: str
          +contact_info: str
      }

      class Booking {
          +booking_id: UUID
          +booking_date: datetime
          +total_amount: Decimal
          +status: BookingStatus
      }

      class Ticket {
          +ticket_number: str
          +seat_number: str
          +status: TicketStatus
          +price: Decimal
      }

      class FlightRef {
          +flight_id: UUID
          +flight_number: str
          +origin: str
          +destination: str
          +departure_time: datetime
          +arrival_time: datetime
          +status: FlightStatus
      }

      class SeatType {
          +type_name: str
          +description: str
      }

      class Option {
          +option_id: UUID
          +name: str
          +price: Decimal
      }

      class Discount {
          +discount_code: str
          +description: str
          +percent_off: int
      }

      enum Role {
          CUSTOMER
      }

      enum BookingStatus {
        RESERVED
        PAID
        CANCELED
        REFUND
      }

      enum TicketStatus {
        BOOKED
        CHECKED_IN
        BOARDED
        CANCELED
        DONE
      }

      enum FlightStatus {
        SCHEDULED
        CANCELED
        COMPLETED
      }
  }

  package "users.repositories" as users_repos {
      class UserRepository
      class FlightRepository
      class BookingRepository
      class TicketRepository
  }

  package "users.services" as users_services {
      class AuthService
      class FlightService
      class BookingService
      class NotificationService
      class PaymentService
  }

  package "users.api.v1" as users_api {
      abstract AuthRouter
      abstract FlightRouter
      abstract BookingRouter
      abstract TicketRouter
      abstract MeRouter
      abstract WsRouter
  }

  UserAccount "1" --> "0..*" Booking : makes
  Booking "1" *-- "1..*" Ticket : includes
  Passenger "1" -- "0..*" Ticket : owns
  Ticket "0..*" -- "0..*" Option : selects
  Booking "0..1" --> "*" Discount : uses
  FlightRef "1" -- "0..*" Ticket : references

  users_api --> users_services
  users_services --> users_repos
  users_repos --> users_models
}

package "staff-service (FastAPI)\nDB: staff_db (PostgreSQL)" {

  package "staff.db.models" as staff_models {
      class StaffUser {
          +user_id: UUID
          +email: str
          +password_hash: str
          +role: StaffRole
      }

      class Flight {
          +flight_id: UUID
          +flight_number: str
          +origin: str
          +destination: str
          +departure_time: datetime
          +arrival_time: datetime
          +status: FlightStatus
      }

      class Airplane {
          +airplane_id: UUID
          +model: str
          +total_seats: int
      }

      class TicketShadow {
          +ticket_number: str
          +passenger_name: str
          +seat_number: str
          +seat_type: str
          +status: TicketStatus
          +flight_id: UUID
      }

      enum StaffRole {
        GATE_MANAGER
        CHECKIN_MANAGER
        SUPERVISOR
      }

      enum FlightStatus {
        SCHEDULED
        CANCELED
        COMPLETED
      }

      enum TicketStatus {
        BOOKED
        CHECKED_IN
        BOARDED
        CANCELED
        DONE
      }

      Airplane "1" -- "0..*" Flight : serves
      Flight "1" -- "0..*" TicketShadow : manifests
  }

  package "staff.repositories" as staff_repos {
      class StaffUserRepository
      class FlightRepository
      class TicketShadowRepository
      class AirplaneRepository
  }

  package "staff.services" as staff_services {
      class CheckinService
      class BoardingService
      class AdminService
      class NotificationService
  }

  package "staff.api.v1" as staff_api {
      abstract AuthRouter
      abstract StaffCheckinRouter
      abstract StaffBoardingRouter
      abstract AdminRouter
      abstract PaymentRouter
      abstract WebhookRouter
      abstract WebSocketRouter
  }

  staff_api --> staff_services
  staff_services --> staff_repos
  staff_repos --> staff_models
}

package "notify-service (FastAPI/Celery workers)" as notify_service {
  package "notify.tasks" as tasks {
      class EmailTasks
      class WebhookTasks
      class ReportTasks
  }
}

node "Broker (Redis/RabbitMQ/Kafka)" as MQ
cloud "Google OAuth" as OAUTH
cloud "Payment Gateway" as PAY


Customer --> FE_USER
StaffUser --> FE_STAFF

FE_USER --> NGINX : HTTPS (REST + WS)
FE_STAFF --> NGINX : HTTPS (REST + WS)

NGINX --> users_api : /api/users/*\n/ws/users/*
NGINX --> staff_api : /api/staff/*\n/ws/staff/*

FE_USER --> OAUTH : OAuth Redirect\n(through backend)
users_api --> OAUTH : token exchange
FE_USER --> PAY : Checkout UI (if direct)
users_api --> PAY : create/confirm intents\n(webhooks -> users_api)

users_services ..> MQ : publish\nBookingCreated\nPaymentCaptured\nCheckInCompleted
MQ ..> users_services : subscribe\nFlightCanceled

staff_services ..> MQ : publish\nFlightScheduled\nFlightCanceled\nPassengerCheckedIn\nPassengerBoarded
MQ ..> staff_services : subscribe\nBookingCreated

MQ ..> tasks : subscribe all\n(events -> emails/webhooks)

FE_USER ..> users_api : WS /ws/users/notifications
FE_STAFF ..> staff_api : WS /ws/staff/{flight_id}

@enduml
